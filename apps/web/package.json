{
	"name": "@reactions/web",
	"version": "3.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync || echo \"\"",
		"dev": "vite dev",
		"build": "vite build",
		"serve:build": "wrangler dev --port 8788 --persist-to ../../.wrangler/state",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"types": "wrangler types src/worker-configuration.d.ts",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state && wrangler d1 migrations apply HISTORY_DB --local --persist-to ../../.wrangler/state",
		"test:e2e": "playwright test",
		"lhci": "lhci autorun --config=./lighthouserc.cjs"
	},
	"dependencies": {
		"@reactions/db": "*",
		"@reactions/engine": "*",
		"@reactions/eve": "*",
		"@reactions/sde": "*",
		"@scalar/api-reference": "^1.73.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@flowbite-svelte-plugins/chart": "^0.2.4",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.3"
	}
}
