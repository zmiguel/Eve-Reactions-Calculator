{
	"name": "eve-reactions-3",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"check": "npm run check --workspaces --if-present && tsc --noEmit -p scripts/tsconfig.json",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "npm run test:e2e -w apps/web",
		"e2e:server": "node scripts/e2e-server.ts",
		"check:legacy": "node scripts/check-legacy-urls.ts",
		"lhci": "npm run lhci -w apps/web",
		"db:generate": "npm run generate -w packages/db",
		"db:migrate:local": "npm run db:migrate:local -w apps/updater && npm run db:migrate:local -w apps/web",
		"seed:local": "node scripts/seed-local.ts",
		"dev:seeded": "node scripts/dev-seeded.ts",
		"pretest": "npm run prepare -w apps/web"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.7",
		"@cloudflare/workers-types": "^5.20261023.1",
		"@eslint/js": "^10.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.4",
		"@vitest/runner": "^4.1.11",
		"@vitest/snapshot": "^4.1.12",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vitest": "^4.1.12",
		"wrangler": "^4.147.0"
	}
}
